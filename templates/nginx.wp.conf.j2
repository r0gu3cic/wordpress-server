server {
	listen 80;
	server_name {{wp.subdomain}};
	root /var/www/{{wp.site_directory}}/wordpress;

	# Hide nginx version
	server_tokens off;

	index index.php;
	charset utf-8;

	# Headers for enhanced security
	add_header X-Frame-Options "SAMEORIGIN";
	add_header X-XSS-Protection "1; mode=block";
	add_header X-Content-Type-Options "nosniff";

	# Logs location
	access_log /var/log/nginx/{{wp.subdomain}}.access.log;
	error_log /var/log//nginx/{{wp.subdomain}}.error.log warn;

	location / {
		try_files $uri $uri/ =404;
	}

	location ~ \.php$ {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/var/run/php/php{{php.version}}-fpm-{{wp.subdomain}}.sock;
	}

	location ~ /\.ht {
		deny all;
	}

	{# 
	location /.well-known/acme-challenge {
		root {{certbot.directory}};
	}
	#}
}
